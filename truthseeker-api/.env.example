# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...
SUPABASE_JWT_SECRET=NOT_SET

# AI APIs
# Reality Defender API Key（从 https://app.realitydefender.ai/dashboard 获取），用于音视频 AIGC 检测
REALITY_DEFENDER_API_KEY=
AIGC_IMAGE_PROVIDER=sightengine          # 图片 AIGC 检测默认用 Sightengine
AIGC_IMAGE_FALLBACK_PROVIDER=reality_defender    # # Sightengine 不可用时，可回退到 RD
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
VIRUSTOTAL_API_KEY=
DOMAIN_PROVENANCE_ENABLED=true    # 是否启用域名溯源
WHOISXML_API_KEY=
WHOISXML_TIMEOUT_SECONDS=20       # WhoisXML 查询超时时间
TEXT_AIGC_DETECTOR_ENABLED=true   # 是否启用内部文本 AIGC 检测工具
TEXT_AIGC_AI_THRESHOLD=0.6        # 内部文本 AI 概率 >= 该阈值时标记为 AI 生成倾向

# 音频 ASR 语义转写（用于音频语义与文本主题一致性校验）
# dotenv 不支持行内注释，注释必须独立成行（见 lessons.md）
# 是否启用 ASR 转写
AUDIO_ASR_ENABLED=true
# ASR 服务商选择：groq（Groq Whisper，海外）或 baidu（百度云短语音识别极速版，国内）
# 只需配置对应服务商的 Key 并修改本值即可切换
AUDIO_ASR_PROVIDER=groq

# --- Groq OpenAI-compatible Whisper（AUDIO_ASR_PROVIDER=groq 时生效）---
# GroqCloud API Key（https://console.groq.com/keys）
GROQ_API_KEY=
GROQ_ASR_BASE_URL=https://api.groq.com/openai/v1
GROQ_ASR_MODEL=whisper-large-v3-turbo

# --- 百度智能云短语音识别极速版（AUDIO_ASR_PROVIDER=baidu 时生效）---
# 百度云控制台创建应用并勾选开通“短语音识别极速版”，取得应用的 API Key 与 Secret Key
# 注意：百度单次识别限 60 秒、仅支持 pcm/wav/amr/m4a；系统会自动用 ffmpeg
# 归一化为 16kHz 单声道 wav 并分段转写（长音频取前约 18 分钟）
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=
# dev_pid 模型选择：80001 为极速版输入法模型（普通话）
BAIDU_ASR_DEV_PID=80001
BAIDU_ASR_BASE_URL=https://vop.baidu.com/pro_api
BAIDU_ASR_TOKEN_URL=https://aip.baidubce.com/oauth/2.0/token
BAIDU_ASR_CUID=truthseeker-api

# 直传单文件大小上限（MB）
AUDIO_ASR_MAX_FILE_MB=50
# 单次转写请求超时（秒）
AUDIO_ASR_TIMEOUT_SECONDS=90
# 取证阶段 ASR 工具整体超时（含下载/提音轨/分段/上传）
AUDIO_ASR_TOOL_TIMEOUT_SECONDS=180
# 留空则按 PATH → C:\Users\user\ffmpeg\bin 查找
FFMPEG_BINARY=
FFPROBE_BINARY=

# Agent 底层全模态模型：kimi-k2.6 \ mimo \minimax 
AGENT_LLM_PROVIDER=minimax
# TruthSeeker 单次 Agent LLM 回复上限；Kimi/MiMo 都按此限制，默认 4k
AGENT_LLM_MAX_OUTPUT_TOKENS=4096
# K2.6 渠道：official / coding / siliconflow
KIMI_PROVIDER=official
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# Kimi K2.6 模型能力：输入 text,image,video；上下文 262144 tokens；官方支持 thinking enabled/disabled，本系统固定 disabled；当前输出上限由 AGENT_LLM_MAX_OUTPUT_TOKENS 控制。
# Kimi coding plan（OpenAI-compatible；如果填 https://api.kimi.com/coding，代码会自动补 /v1）
KIMI_CODING_API_KEY=
KIMI_CODING_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODING_MODEL=kimi-k2.6
# Kimi SiliconFlow 渠道
KIMI_SILICONFLOW_API_KEY=
KIMI_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
KIMI_SILICONFLOW_MODEL=Pro/moonshotai/Kimi-K2.6
# 小米 MiMo Token Plan（OpenAI-compatible；AGENT_LLM_PROVIDER=mimo 时生效）
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
# MiMo V2.5 模型能力：输入 text,image；官方上下文 1048576 tokens；官方输出上限 131072 tokens；本系统输出上限由 AGENT_LLM_MAX_OUTPUT_TOKENS 控制。
# MiMo thinking：官方支持 enabled/disabled；默认 enabled。enabled 时官方不支持自定义 temperature，代码按 1.0 传入。
MIMO_THINKING=enabled
# MiniMax 中转站（OpenAI-compatible；AGENT_LLM_PROVIDER=minimax 时生效）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://minnimax.chat/v1
MINIMAX_MODEL=MiniMax-M3
# MiniMax 中转站：OpenAI 协议 v1 endpoint；支持 Claude/GPT 等多模型；本系统输出上限由 AGENT_LLM_MAX_OUTPUT_TOKENS 控制。

EXA_API_KEY=
EXA_BASE_URL=https://api.exa.ai

# 公开案例库 RAG embedding（SiliconFlow OpenAI-compatible embeddings）
CASE_RAG_ENABLED=true
CASE_RAG_TOP_K=5
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
EMBEDDING_DIMENSIONS=1024

# 以下当前未被代码直接使用，保留用于未来 LLM 提供商切换
OPENAI_API_KEY=
QWEN_API_KEY=

# App
APP_ENV=development
FRONTEND_URL=http://localhost:3000
MAX_ROUNDS=5
CONVERGENCE_THRESHOLD=0.08
